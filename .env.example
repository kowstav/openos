# Server-side only. Never commit real keys. Activation/validation table:
# docs/i5-release.md ("Credential activation").
# Data directory for the durable store (deployment config, not a secret):
# OPENOS_DATA_DIR=.openos-data
MODEL_API_KEY=
# Fallback name also supported:
META_API_KEY=
# Optional, raises GitHub rate limits:
GITHUB_TOKEN=
# Isolated execution provider for untrusted repositories.
# Unset/misspelled = untrusted jobs are REFUSED (fail closed, never host).
# SANDBOX_PROVIDER=modal
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# Trusted-fixture host runner (tests only, never for arbitrary repos):
# SANDBOX_PROVIDER=local-trusted-fixtures
# OPENOS_ENABLE_LOCAL_FIXTURES=1
